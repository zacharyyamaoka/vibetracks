filters:
  and:
    - note["vibe-track"] == "feature"
    - file.inFolder("features")

views:
  - type: vibetracks-graph
    name: Graph
    statusProperty: note.vibe-status
    dependencyProperty: note.vibe-depends-on
    areaProperty: note.vibe-areas
  - type: vibetracks-kanban
    name: Kanban
    statusProperty: note.vibe-status
  - type: vibetracks-focus
    name: Focus
    statusProperty: note.vibe-status
    reviewPacketProperty: note.vibe-review-packet
  - type: table
    name: Plain data
    order:
      - file.name
      - vibe-id
      - vibe-status
      - vibe-depends-on
      - vibe-areas

vibetracks:
  version: 1
  id: pyblocks-demo
  title: Pyblocks development
  description: A real file-backed Vibe Tracks sample. Graph, Kanban, and Focus read the same Markdown feature conversations.
  vaultRoot: .
  source: features
  statuses: [backlog, ready, running, waiting, review, frontier, done, archived]
  marker:
    property: vibe-track
    value: feature
  # Area memory: the shared tagging vocabulary. Humans and dispatch agents
  # reuse these before inventing new ones; new themes get added here with a
  # one-line description.
  areas:
    writeback: Reverse-pass edits that mutate source files
    round-trip: Forward/backward projection equivalence
    workspace: Multi-file indexing and resolution
    evaluator: Held-out correctness measurement
    contracts: Interface envelopes and invariants
    blockview: Block View rendering surface
    ui: Gesture and interaction wiring
    product: Naming, policy, and scope decisions
    history: Prototype preservation and archaeology
    resolution: Alias and identity resolution
  properties:
    id: vibe-id
    status: vibe-status
    description: vibe-description
    dependsOn: vibe-depends-on
    areas: vibe-areas
    priority: vibe-priority
    archived: vibe-archived
    reviewPacket: vibe-review-packet
    preview: vibe-preview
    evidence: vibe-evidence
    runs: vibe-runs
