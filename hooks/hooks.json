{
  "description": "Write this session's card into the Vibe Tracks vault (vibetracks/remote/card.py). A machine without the vault writes nothing.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "p=python3; \"$p\" -c '' 2>/dev/null || p=python; \"$p\" -I \"${CLAUDE_PLUGIN_ROOT}/vibetracks/remote/card.py\"; exit 0",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "p=python3; \"$p\" -c '' 2>/dev/null || p=python; \"$p\" -I \"${CLAUDE_PLUGIN_ROOT}/vibetracks/remote/card.py\"; exit 0",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "p=python3; \"$p\" -c '' 2>/dev/null || p=python; \"$p\" -I \"${CLAUDE_PLUGIN_ROOT}/vibetracks/remote/card.py\"; exit 0",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
