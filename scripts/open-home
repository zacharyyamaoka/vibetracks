#!/usr/bin/env bash
# Open the Vibe Tracks home: start (or reuse) this checkout's channel, then open the home page in it.
#
#   /home/bam/vibetracks/scripts/open-home             # main checkout: Stable (what the dock icon opens); a worktree: its lane
#   /home/bam/vibetracks/scripts/open-home --no-open   # start or reuse, print the URL only
#
# Constructive and idempotent, like scripts/open-dashboard: pressing it twice reuses the running channel and opens one
# more tab. It never stops anything; stop a lane yourself with `/home/bam/.local/bin/sps --root <checkout> dev --stop`.
#
# WHY Stable from the main checkout (open-dashboard opens Preview there): the home is the page Zach uses every morning,
# so it opens the build he promoted, the one the dock icon serves (docs/peps/0001). In a worktree it is that lane's
# own `sps dev`, so an agent hands over its own build.
# WHY the /api/plugins/vibetracks/home/ path: the page is served by the plugin backend's /home mount through Clank's
# proxy, the same origin and path on Stable, Preview and every lane. A bare / lands there too (clank/src/plugin.tsx).
# WHY /home/bam/.local/bin/open: xdg-open and gio open are blocked by the no-focus-steal hook, and the shim detaches
# the browser so this script returns at once.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SPS="${SPS:-/home/bam/.local/bin/sps}"
OPENER="${OPENER:-/home/bam/.local/bin/open}"
HOME_PATH="api/plugins/vibetracks/home/"

open_url=1
if [[ "${1:-}" == "--no-open" ]]; then open_url=0; fi

git_dir="$(git -C "$ROOT" rev-parse --git-dir)"
common_dir="$(git -C "$ROOT" rev-parse --git-common-dir)"
if [[ "$(cd "$ROOT" && realpath "$git_dir")" != "$(cd "$ROOT" && realpath "$common_dir")" ]]; then
  base="$("$SPS" --root "$ROOT" dev | grep -Eo 'http://127\.0\.0\.1:[0-9]+/' | tail -n 1)"
else
  base="$(SPS_NO_WINDOW=1 "$SPS" --root "$ROOT" open --no-open 2>/dev/null | grep -Eo 'http://127\.0\.0\.1:[0-9]+/' | tail -n 1 || true)"
  base="${base:-http://127.0.0.1:4394/}"
fi
if [[ -z "$base" ]]; then
  echo "open-home: sps did not print a URL" >&2
  exit 1
fi
url="${base}${HOME_PATH}"
echo "$url"
if [[ "$open_url" == 1 ]]; then
  "$OPENER" "$url"
fi
