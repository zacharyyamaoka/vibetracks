{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bam-schema:bam-roadmap/1",
  "$comment": "Anchored patterns end in (?![\\s\\S]) rather than $, the loops' convention: Python's re lets $ match before a trailing newline. What a schema cannot say (ids unique, edges and evidence ids resolve, every status re-derives from its criteria, every link that says exists:true opens) is checked in code by `python -m vibetracks.roadmap.projector validate`.",
  "title": "bam-roadmap/1",
  "description": "One loop's roadmap and its proof of done, projected from the files the loop already writes. Rungs carry done_when: typed criteria (NASA/INCOSE verification methods), each resolved to evidence links that open, and a status derived from that evidence. loop-status/1 stays the one-screen summary; this is what a click on a rung opens. Consumers ignore unknown fields inside `x` and `facts` (in-toto's parsing rule); everything else is closed.",
  "type": "object",
  "required": [
    "schema",
    "loop",
    "title",
    "generated_at",
    "as_of",
    "roots",
    "sources",
    "rules",
    "summary",
    "counts",
    "warnings",
    "axes",
    "where",
    "rungs",
    "edges",
    "work",
    "unresolved",
    "scopes"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "bam-roadmap/1"
    },
    "loop": {
      "$ref": "#/$defs/identifier"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "$ref": "#/$defs/timestamp"
    },
    "as_of": {
      "description": "The ruler the statuses are judged by: evidence counts only at a commit in head's history, under this context.",
      "type": "object",
      "required": [
        "head",
        "branch",
        "context"
      ],
      "additionalProperties": false,
      "properties": {
        "head": {
          "$ref": "#/$defs/full_sha"
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "context": {
          "type": "object",
          "description": "Loop invariants evidence must match (kinsim: ruler_id, ruler_sha256, and ruler_via, the curriculum file whose ruler field names the ruler at any commit)."
        }
      }
    },
    "roots": {
      "description": "What each link's `base` resolves against (SARIF's originalUriBaseIds).",
      "type": "object",
      "required": [
        "repo"
      ],
      "additionalProperties": false,
      "properties": {
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "data_home": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/link_fields"
          }
        ],
        "type": "object",
        "required": [
          "role",
          "sha256"
        ],
        "properties": {
          "kind": {},
          "label": {},
          "path": {},
          "base": {},
          "abs": {},
          "line": {},
          "end_line": {},
          "exists": {},
          "why_unresolved": {},
          "role": {
            "type": "string"
          },
          "sha256": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/sha256"
              }
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "rules": {
      "type": "object",
      "required": [
        "proof_strengths",
        "status_rule",
        "loop_rules"
      ],
      "additionalProperties": false,
      "properties": {
        "proof_strengths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/strength"
          }
        },
        "status_rule": {
          "type": "string"
        },
        "loop_rules": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "wave",
        "phase",
        "frontier",
        "milestone",
        "links"
      ],
      "properties": {
        "wave": {
          "type": [
            "integer",
            "null"
          ]
        },
        "phase": {
          "type": [
            "string",
            "null"
          ]
        },
        "frontier": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "milestone": {
          "type": [
            "object",
            "null"
          ]
        },
        "links": {
          "type": "object"
        }
      }
    },
    "counts": {
      "type": "object",
      "required": [
        "by_status",
        "claimed_green_not_proven",
        "evidence_items",
        "unresolved_links"
      ],
      "additionalProperties": false,
      "properties": {
        "by_status": {
          "type": "object",
          "required": [
            "green",
            "done",
            "stale",
            "claimed",
            "partial",
            "missing"
          ],
          "additionalProperties": false,
          "properties": {
            "green": {
              "$ref": "#/$defs/count"
            },
            "done": {
              "$ref": "#/$defs/count"
            },
            "stale": {
              "$ref": "#/$defs/count"
            },
            "claimed": {
              "$ref": "#/$defs/count"
            },
            "partial": {
              "$ref": "#/$defs/count"
            },
            "missing": {
              "$ref": "#/$defs/count"
            }
          }
        },
        "claimed_green_not_proven": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "evidence_items": {
          "$ref": "#/$defs/count"
        },
        "unresolved_links": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "axes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "order"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/identifier"
          },
          "title": {
            "type": "string"
          },
          "order": {
            "type": "integer"
          }
        }
      }
    },
    "where": {
      "description": "loop-status/1's `where` rows from derived statuses; here_claimed is the same row from the loop's own claims.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "axis",
          "here",
          "status",
          "next",
          "here_claimed"
        ],
        "additionalProperties": false,
        "properties": {
          "axis": {
            "$ref": "#/$defs/identifier"
          },
          "here": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/identifier"
              }
            ]
          },
          "status": {
            "enum": [
              "green",
              "partial",
              "missing"
            ]
          },
          "next": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/identifier"
              }
            ]
          },
          "here_claimed": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/identifier"
              }
            ]
          }
        }
      }
    },
    "rungs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rung"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "kind",
          "via"
        ],
        "additionalProperties": false,
        "properties": {
          "from": {
            "$ref": "#/$defs/identifier"
          },
          "to": {
            "$ref": "#/$defs/identifier"
          },
          "kind": {
            "enum": [
              "prerequisite",
              "same_as",
              "package"
            ]
          },
          "via": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "work": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/work"
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rung",
          "kind",
          "path",
          "why"
        ],
        "additionalProperties": false,
        "properties": {
          "rung": {
            "$ref": "#/$defs/identifier"
          },
          "evidence": {
            "type": "string"
          },
          "criterion": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "why": {
            "type": "string"
          }
        }
      }
    },
    "scopes": {
      "description": "Named scopes targets refer to as '@name' (kinsim: producer, the execution path of the producer command plus the scorer its judge calls).",
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*(?![\\s\\S])"
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2}(\\.[0-9]+)?)?(Z|[+-][0-9]{2}:[0-9]{2})?(?![\\s\\S])"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}(?![\\s\\S])"
    },
    "full_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}(?![\\s\\S])"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "status": {
      "enum": [
        "green",
        "done",
        "stale",
        "claimed",
        "partial",
        "missing"
      ]
    },
    "claimed_status": {
      "enum": [
        "green",
        "done",
        "partial",
        "missing"
      ]
    },
    "verdict": {
      "enum": [
        "met",
        "stale",
        "unknown",
        "unmet"
      ]
    },
    "strength": {
      "enum": [
        "record",
        "log",
        "claim"
      ]
    },
    "result": {
      "description": "in-toto test-result PASSED / WARNED / FAILED, lowercased, plus JUnit's error and skipped.",
      "enum": [
        "passed",
        "warned",
        "failed",
        "error",
        "skipped",
        null
      ]
    },
    "link_fields": {
      "description": "A path that opens: `abs` is set only when it exists now; otherwise `why_unresolved` says why. Lines are 1-based (SARIF region.startLine).",
      "type": "object",
      "required": [
        "kind",
        "label",
        "path",
        "base",
        "abs",
        "line",
        "end_line",
        "exists",
        "why_unresolved"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "base": {
          "enum": [
            "repo",
            "data_home",
            "abs",
            null
          ]
        },
        "abs": {
          "type": [
            "string",
            "null"
          ]
        },
        "line": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 1
            }
          ]
        },
        "end_line": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 1
            }
          ]
        },
        "exists": {
          "type": "boolean"
        },
        "why_unresolved": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "source": {
      "description": "Where a requirement is declared: the file, its line, and its RFC 6901 JSON Pointer.",
      "allOf": [
        {
          "$ref": "#/$defs/link_fields"
        }
      ],
      "type": "object",
      "required": [
        "pointer"
      ],
      "properties": {
        "kind": {},
        "label": {},
        "path": {},
        "base": {},
        "abs": {},
        "line": {},
        "end_line": {},
        "exists": {},
        "why_unresolved": {},
        "pointer": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "target": {
      "description": "What a criterion names (a test file, a corpus, a rung, a package, a gate) and the verdict its chosen evidence gives it.",
      "allOf": [
        {
          "$ref": "#/$defs/link_fields"
        }
      ],
      "type": "object",
      "required": [
        "verdict",
        "strength",
        "evidence",
        "commit",
        "note",
        "changed_since",
        "scope",
        "context",
        "spec"
      ],
      "properties": {
        "kind": {
          "enum": [
            "test",
            "file",
            "corpus",
            "rung",
            "package",
            "gate",
            "audit"
          ]
        },
        "label": {},
        "path": {},
        "base": {},
        "abs": {},
        "line": {},
        "end_line": {},
        "exists": {},
        "why_unresolved": {},
        "verdict": {
          "$ref": "#/$defs/verdict"
        },
        "strength": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/strength"
            }
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_id"
          }
        },
        "commit": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/commit"
            }
          ]
        },
        "note": {
          "type": "string"
        },
        "changed_since": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scope": {
          "description": "What must not have changed since the evidence for it to hold (Codex F08, G08): repository paths, a trailing / for a whole folder; an entry '@name' stands for the document's scopes[name] (a measured reading's producer path, stored once). Markdown never counts.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "context": {
          "description": "Loop invariants the evidence must have been made under (kinsim: ruler_sha256); a mismatch makes it stale.",
          "type": "object"
        },
        "spec": {
          "description": "What the target's evidence is judged against when that is more than pass/fail: a measured gate's window (rule, tier, corpus, count, latency, needed, feasible_rate_min, recovery_min, metric, and inputs: the corpus as the curriculum defines it now, which every reading's run manifest must have recorded, else the reading is stale (Codex H04)) or a gate tier (rule gate, tier, expected_suites). null otherwise.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "evidence_id": {
      "type": "string",
      "pattern": "^e[0-9]+(?![\\s\\S])"
    },
    "test_case": {
      "description": "One JUnit testcase under the target file, parameters kept (Codex F06): its pytest node id, the def line of its function at the head, and its outcome.",
      "type": "object",
      "required": [
        "node_id",
        "line",
        "outcome"
      ],
      "additionalProperties": false,
      "properties": {
        "node_id": {
          "type": "string",
          "pattern": "::"
        },
        "line": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 1
            }
          ]
        },
        "outcome": {
          "enum": [
            "passed",
            "skipped",
            "failed",
            "error",
            "failed+error"
          ]
        }
      }
    },
    "evidence": {
      "description": "One artifact (or, at strength claim, the loop's own sentence) with its result read from the artifact. path and line are separate fields, never 'path:N'. role says whether the rung's derived status rests on it (supports), a newer item or status event replaced it (superseded), or it is shown for context.",
      "allOf": [
        {
          "$ref": "#/$defs/link_fields"
        }
      ],
      "type": "object",
      "required": [
        "id",
        "result",
        "strength",
        "commit",
        "ts",
        "origin",
        "facts",
        "as_cited",
        "event",
        "role",
        "superseded_by",
        "commit_source"
      ],
      "properties": {
        "kind": {
          "enum": [
            "test",
            "junit",
            "gate_report",
            "log",
            "run",
            "commit",
            "file",
            "image",
            "video",
            "audit",
            "statement"
          ]
        },
        "label": {},
        "path": {},
        "base": {},
        "abs": {},
        "line": {},
        "end_line": {},
        "exists": {},
        "why_unresolved": {},
        "id": {
          "$ref": "#/$defs/evidence_id"
        },
        "result": {
          "$ref": "#/$defs/result"
        },
        "strength": {
          "$ref": "#/$defs/strength"
        },
        "commit": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/commit"
            }
          ]
        },
        "ts": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/timestamp"
            }
          ]
        },
        "origin": {
          "enum": [
            "event",
            "ledger",
            "junit",
            "gate_report",
            "curriculum",
            "ladder",
            "audit_event"
          ]
        },
        "facts": {
          "type": "object"
        },
        "cases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/test_case"
          }
        },
        "via": {
          "$ref": "#/$defs/evidence_id"
        },
        "witnesses": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "code",
              "count",
              "episode",
              "scorecard",
              "log"
            ],
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string"
              },
              "count": {
                "$ref": "#/$defs/count"
              },
              "episode": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "scorecard": {
                "$ref": "#/$defs/link_fields"
              },
              "log": {
                "$ref": "#/$defs/link_fields"
              }
            }
          }
        },
        "as_cited": {
          "description": "The path exactly as the loop wrote it in an event (no :N suffix); null when the item did not come from the loop's text verbatim.",
          "type": [
            "string",
            "null"
          ]
        },
        "event": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/event_ref"
            }
          ]
        },
        "run_id": {
          "description": "A ledger run's id, verbatim (kind run only).",
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "supports",
            "superseded",
            "context"
          ]
        },
        "superseded_by": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/evidence_id"
            }
          ]
        },
        "commit_source": {
          "description": "Where commit came from (Codex G04, H02): artifact (a record the run itself wrote binds it to a commit and a clean tree: a log's own HEAD line, a run manifest's or ledger row's git, a gate report's git, an audit's own 'candidate <sha>' line, the head for an inspection), artifact-dirty (that record says its tree had uncommitted changes, or does not say it was clean: a claim), citation (only the loop's event says so: a claim), or null (no commit). A file time or git's reflog binds nothing.",
          "enum": [
            "artifact",
            "artifact-dirty",
            "citation",
            null
          ]
        }
      },
      "additionalProperties": false
    },
    "criterion": {
      "description": "One clause of done_when. kind says what is checked; method is the NASA SP-2016-6105 / INCOSE verification method (null for structural clauses). A stated criterion is a condition the loop writes only in prose (Codex F11): it is always unknown until the loop declares it as data.",
      "type": "object",
      "required": [
        "id",
        "kind",
        "method",
        "title",
        "text",
        "source",
        "targets",
        "verdict",
        "strength",
        "reason",
        "evidence",
        "at"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*#[a-z-]+(?![\\s\\S])"
        },
        "kind": {
          "enum": [
            "test",
            "gate_run",
            "audit",
            "inspection",
            "demonstration",
            "package",
            "prerequisites",
            "alias",
            "stated"
          ]
        },
        "method": {
          "enum": [
            "test",
            "analysis",
            "demonstration",
            "inspection",
            null
          ]
        },
        "title": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "source": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/source"
            }
          ]
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/target"
          }
        },
        "verdict": {
          "$ref": "#/$defs/verdict"
        },
        "strength": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/strength"
            }
          ]
        },
        "reason": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_id"
          }
        },
        "at": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/commit"
          }
        }
      },
      "allOf": [
        {
          "description": "Only a met or stale criterion rests on evidence of some strength.",
          "if": {
            "properties": {
              "verdict": {
                "enum": [
                  "unknown",
                  "unmet"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "strength": {
                "type": "null"
